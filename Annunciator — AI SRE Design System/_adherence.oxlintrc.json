{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/readout/**",
              "components/status/**",
              "components/surface/**",
              "ui_kits/incident-dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono|Departure Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono, Departure Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApproveButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ApproveButton> doesn't accept that prop. Declared props: children, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataReadout'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|align|style|key|ref|className|style|children)$/]",
        "message": "<DataReadout> doesn't accept that prop. Declared props: value, unit, label, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataReadout'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataReadout> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:inset|style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: inset, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|variant|uppercase|as|style|key|ref|className|style|children)$/]",
        "message": "<MetaLabel> doesn't accept that prop. Declared props: children, size, variant, uppercase, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaLabel'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|caption)$/]",
        "message": "<MetaLabel> size must be one of 'sm' | 'caption'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaLabel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:meta|caps)$/]",
        "message": "<MetaLabel> variant must be one of 'meta' | 'caps'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|label|actions|flush|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: as, label, actions, flush, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|variant|label|on|style|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, variant, label, on, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:nominal|caution|warning)$/]",
        "message": "<StatusBadge> variant must be one of 'nominal' | 'caution' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='on'] > Literal[value!=/^(?:panel|page)$/]",
        "message": "<StatusBadge> on must be one of 'panel' | 'page'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|count|current|failed|labels|style|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: steps, count, current, failed, labels, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:content|placement|children|style|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: content, placement, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='placement'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<Tooltip> placement must be one of 'top' | 'bottom'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],

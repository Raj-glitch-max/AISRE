# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtualenv — recreate with: python3 -m venv venv && pip install -r requirements.txt
venv/
.venv/

# Runtime state — the schema is created on startup by Base.metadata.create_all()
incidents.db

# Secrets — NVIDIA_API_KEY belongs in the environment, never in the repo
.env

# OS
.DS_Store

# AWS credential exports. rootkey.csv is what the console hands you when you create
# ROOT account keys — it must never be committed, and ideally should not exist at all.
rootkey.csv
*accessKeys*.csv
credentials.csv

# Terraform — state can contain secrets (DB password, NIM key), never commit it.
# The lock file IS committed deliberately, so provider versions are reproducible.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tf.plan
infra/build/
*.auto.tfvars
terraform.tfvars

# Sibling repos (atlas, kube-llm/KLRB) pulled into this project folder for local
# reference/dev — each has its own .git, never to be committed here as files or
# as a gitlink (see flow.md's victim-app gitlink incident for why).
/atlas/
/kube-llm/
